---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Weather from "@/components/Weather.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "efb");
const title = t("pages.weather.title");
const description = t("pages.weather.description");
---

<AppLayout title={title} description={description}>
  <PageHeader title={title} description={description} />
  <Weather messages={getMessages(locale, "efb")} client:load />
</AppLayout>
