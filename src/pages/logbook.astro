---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Logbook from "@/components/Logbook.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "efb");
const title = t("pages.logbook.title");
const description = t("pages.logbook.description");
---

<AppLayout title={title} description={description}>
  <PageHeader title={title} description={description} />
  <Logbook messages={getMessages(locale, "efb")} client:load />
</AppLayout>
