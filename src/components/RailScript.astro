---
/**
 * 侧栏折叠状态的无闪烁初始化，和 ThemeScript 同一个道理、同一种写法。
 *
 * 这两件事都是「用户上次选的样子」，都存在 localStorage 里，也都在首屏就看得
 * 见。等 AppRail 水合再读，用户会先看到一次展开的轨、再看着它收起去 —— 和主
 * 题闪烁一模一样的毛病，只不过这一次跳动的是布局：正文那一列会横向平移 12rem。
 *
 * 写的是 <html> 上的 data-rail，因为轨的宽度和正文的左内边距都从同一个 CSS 变
 * 量取值（globals.css 的 "can-efb only" 一节）。AppRail 挂载时把它读回来当作
 * 自己的初始 state，而不是第二次去读 localStorage：两处各判断一次，就会有两个
 * 可能不一致的答案。
 *
 * 三个值：`collapsed` / `expanded` 是成员点过折叠钮之后的选择；`auto` 是没选过，
 * 由 CSS 按宽度决定（768–1151 收起，其余展开），JS 读 `--rail-auto` 得到答案
 * （`lib/panelLayout.ts` 的 `effectiveRail`）。断点因此仍然只写在 globals.css 里。
 *
 * `is:inline` 是必须的 —— 整件事的意义就在于它不被打包、不被 defer。
 */
---

<script is:inline>
  (function () {
    var root = document.documentElement;
    try {
      var stored = localStorage.getItem("efb.rail");
      // 成员选过就照他选的；没选过写 auto，交给 CSS 按宽度定（平板收起、桌面展开）。
      root.dataset.rail =
        stored === "collapsed" || stored === "expanded" ? stored : "auto";
    } catch (e) {
      // 锁死的浏览器里 localStorage 会抛。auto 是个完全合理的结果，而且这么早
      // 也没有地方可以上报。
      root.dataset.rail = "auto";
    }
  })();
</script>
