---
/**
 * 外壳：**地图铺满视口，面板浮在上面。** 没有站头，也不要加回来。
 *
 * 轨、手机标签栏和「我的」面板是 can-ui 的 `CanFrame`（`layout="rail"`），经
 * `components/Frame.vue` 传入。面板在 Frame 的默认插槽里，落在
 * `<main id="main-content">` 之内。地图不进插槽：`transition:persist` 让它跨页面
 * 存活，它排在 Frame 后面。
 *
 * 层次自下而上：MapStage → 面板 → 轨。DOM 顺序：跳过链接、轨、标签栏、面板、地图。
 *
 * `client:load` 给三样：Frame、地图、每一页自己的主岛屿。
 *
 * 岛屿只拿自己那一本：Frame 拿 `efb.frame`，地图拿翻好的字符串。岛屿的 props 会
 * 原样序列化进每个页面的 HTML。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/Frame.vue";
import MapStage from "@/components/map/MapStage.vue";
import FloatingPanel from "@/components/FloatingPanel.astro";
import { originsFromEnv } from "@jianyuelab-org/can-ui/sites";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { buildNav, buildProfileItems } from "@/lib/nav";
import { toFrameUser } from "@/lib/session";
import { signInUrl } from "@/lib/config";
import type { PanelWidth } from "@/lib/panelLayout";

interface Props {
  title: string;
  description?: string;
  /** 面板宽度。表单页（飞行计划、设置）用 `wide`，其余 `standard`。 */
  panel?: PanelWidth;
}

const { title, description, panel = "standard" } = Astro.props;

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "efb");

// 中间件已经问过 can-api 了，这里只是取出来 —— 不要在页面里再解一次会话。
const user = toFrameUser(Astro.locals.user);
---

<BaseLayout title={title} description={description}>
  <Frame
    locale={locale}
    pathname={Astro.url.pathname}
    nav={buildNav(t)}
    user={user}
    profileItems={buildProfileItems(t)}
    signInHref={signInUrl(Astro.url)}
    messages={getMessages(locale, "efb.frame")}
    origins={originsFromEnv(import.meta.env)}
    client:load
  >
    <FloatingPanel
      width={panel}
      title={title}
      description={description}
      labels={{
        collapse: t("panel.collapse"),
        expand: t("panel.expand"),
        handle: t("panel.handle"),
        sheet: {
          collapsed: t("panel.sheet.collapsed"),
          half: t("panel.sheet.half"),
          full: t("panel.sheet.full"),
        },
      }}
    >
      <slot />
    </FloatingPanel>
  </Frame>

  {
    /*
      地图跨页面存活：`transition:persist` 让 Astro 在导航时保留这个岛屿的实例。
      没有它，每换一页地图都要重新初始化、底图重新下载一遍。它不进 Frame 的插槽：
      插槽里的东西每页随新文档换掉。
    */
  }
  <MapStage
    label={t("route.map.label")}
    cid={Astro.locals.user?.username ?? null}
    t={{
      denied: t("map.denied"),
      emptyNavaids: t("map.emptyLayer.navaids"),
      emptyGeneric: t("map.emptyLayer.generic"),
      planOnMap: t("map.planOnMap"),
      layersMenu: t("map.layersMenu"),
      layerFailed: t("map.layerFailed"),
      retry: t("common.retry"),
      locate: t("map.locate"),
      view3d: t("map.view3d"),
      view3dHint: t("map.view3dHint"),
      chart: t("map.chart.label"),
      chartHigh: t("map.chart.high"),
      chartLow: t("map.chart.low"),
      weatherLight: t("map.weather.light"),
      weatherHeavy: t("map.weather.heavy"),
      atc: {
        close: t("map.atc.close"),
        airspace: t("map.atc.airspace"),
        covering: t("map.atc.covering"),
        extending: t("map.atc.extending"),
        frequency: t("map.atc.frequency"),
        member: t("map.atc.member"),
        rating: t("map.atc.rating"),
        online: t("map.atc.online"),
        atisText: t("map.atc.atisText"),
        controllerInfo: t("map.atc.controllerInfo"),
      },
      pilot: {
        close: t("map.pilot.close"),
        locate: t("map.pilot.locate"),
        onGround: t("map.pilot.onGround"),
        airborne: t("map.pilot.airborne"),
        noFlightPlan: t("map.pilot.noFlightPlan"),
        remaining: t("map.pilot.remaining"),
        eta: t("map.pilot.eta"),
        altitude: t("map.pilot.altitude"),
        level: t("map.pilot.level"),
        groundspeed: t("map.pilot.groundspeed"),
        heading: t("map.pilot.heading"),
        squawk: t("map.pilot.squawk"),
        rules: t("map.pilot.rules"),
        flightPlan: t("map.pilot.flightPlan"),
        aircraft: t("map.pilot.aircraft"),
        cruise: t("map.pilot.cruise"),
        tas: t("map.pilot.tas"),
        alternate: t("map.pilot.alternate"),
        member: t("map.pilot.member"),
        online: t("map.pilot.online"),
      },
    }}
    failureText={{
      init: t("map.failure.init"),
      webgl: t("map.failure.webgl"),
    }}
    layerLabels={{
      airways: t("map.layers.airways"),
      firs: t("map.layers.firs"),
      navaids: t("map.layers.navaids"),
      mora: t("map.layers.mora"),
      traffic: t("map.layers.traffic"),
      atcLive: t("map.layers.atcLive"),
      ctr: t("map.layers.ctr"),
      app: t("map.layers.app"),
      restricted: t("map.layers.restricted"),
      weather: t("map.layers.weather"),
    }}
    client:load
    transition:persist
  />
</BaseLayout>
