---
/**
 * 页面外框 —— `<head>`、两个首屏脚本、`<body>`，仅此而已。
 *
 * 和 can-web / can-dev / can-radar 的 BaseLayout 是同一份形状，差别只有两处，
 * 都是这个站没有站头带来的：多了一个 RailScript（侧栏折叠状态要在首屏之前定
 * 下来），少了 `floatingControls` 那个开关（主题和语言在轨里，不在右下角的浮
 * 动药丸上，所以这里没有第二个位置需要开关）。
 *
 * 外壳不在这一层。要外壳的页面用 AppLayout；这一层留给以后**不要**外壳的页面
 * —— 登录回跳、打印视图、全屏航图。can-dev 把站头塞进外框里，后来又拆了出来，
 * 这里直接从拆开的形状起步。
 */
import "@/styles/globals.css";
import ThemeScript from "@jianyuelab-org/can-ui/components/ThemeScript.astro";
import RailScript from "@/components/RailScript.astro";
import { getLocale, useTranslations } from "@/lib/i18n";

interface Props {
  /** 页面标题，会拼上站名。 */
  title?: string;
  description?: string;
}

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "efb");

const { title, description = t("tagline") } = Astro.props;
const fullTitle = title ? `${title} · ${t("siteName")}` : t("siteName");
---

<!doctype html>
<html lang={locale} class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* public/ 里现在只有 Astro 模板留下的 favicon。三个兄弟站还引用
        favicon-32.png / apple-touch-icon.png / icon-512.png —— 品牌资源到位
        之后把那三行一起补上，现在指过去只会是三个 404。 */
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4c92c1" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* EFB 是登录后才有意义的工具，没有值得被搜索引擎收录的公开页面。 */}
    <meta name="robots" content="noindex" />
    <ThemeScript />
    <RailScript />
  </head>
  <body class="min-h-dvh bg-surface">
    <slot />
  </body>
</html>
