---
/**
 * 页面外框 —— `<head>`、两个首屏脚本、`<body>`，仅此而已。
 *
 * 两个首屏脚本都来自 can-ui：`ThemeScript`（主题）和 `RailScript`（轨的折叠状态，
 * 写 `<html data-rail>`，存储键 `efb.rail`）。
 *
 * 外壳不在这一层。要外壳的页面用 AppLayout；这一层留给**不要**外壳的页面。
 */
import "@/styles/globals.css";
import ThemeScript from "@jianyuelab-org/can-ui/components/ThemeScript.astro";
import RailScript from "@jianyuelab-org/can-ui/components/RailScript.astro";
import PersistHtmlState from "@/components/PersistHtmlState.astro";
import { ClientRouter } from "astro:transitions";
import { getLocale, useTranslations } from "@/lib/i18n";

interface Props {
  /** 页面标题，会拼上站名。 */
  title?: string;
  description?: string;
}

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "efb");

const { title, description = t("tagline") } = Astro.props;
const fullTitle = title ? `${title} · ${t("siteName")}` : t("siteName");
---

<!doctype html>
<html lang={locale} class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* public/ 里现在只有 favicon.svg。品牌资源到位之后再补 favicon-32.png /
        apple-touch-icon.png / icon-512.png，现在指过去只会是三个 404。 */
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4c92c1" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* EFB 是登录后才有意义的工具，没有值得被搜索引擎收录的公开页面。 */}
    <meta name="robots" content="noindex" />
    <ThemeScript />
    <RailScript />
    {
      /*
      ClientRouter 为地图的 `transition:persist` 而来。导航由客户端接管，两个首屏
      脚本因此要经得起重复执行；ThemeScript 和 RailScript 都是幂等的。

      PersistHtmlState 必须和 ClientRouter 成对存在：换页时 <html> 上的属性会被
      换掉，而主题和 data-rail 正好写在那里。
    */
    }
    <PersistHtmlState />
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-surface">
    <slot />
  </body>
</html>
